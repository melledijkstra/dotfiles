# Shared Odysea secrets template.
# Copy to ~/.config/odysea/secrets.env and chmod 600:
#   mkdir -p ~/.config/odysea
#   cp ~/projects/dotfiles/config/odysea/secrets.env.example ~/.config/odysea/secrets.env
#   chmod 600 ~/.config/odysea/secrets.env

# Google OAuth2 Credentials (optional — non-Google workflows run without these)
# Get these from the Google Cloud Console (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
