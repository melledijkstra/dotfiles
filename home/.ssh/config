# Github Personal Account
# Automatically use personal ssh key when in projects folder
Match host github.com exec "pwd | grep ~/projects"
  IdentityFile ~/.ssh/id_ed25519_personal

# Also for public github repos use personal ssh key
Match host github.com exec "pwd | grep ~/github"
  IdentityFile ~/.ssh/id_ed25519_personal

# Github Work Account
# Automatically use work ssh key when in work folder
Match host github.com exec "pwd | grep ~/work"
  IdentityFile ~/.ssh/id_ed25519_work

# Default Github fallback
# Fallback to the personal one
Host github.com
  HostName github.com
  User git
  AddKeysToAgent yes
  IdentitiesOnly yes

# Optional work-specific SSH configuration
Include ~/.ssh/config.work

# Add colima config, needed for colima + docker
Include /Users/dijksmel/.colima/ssh_config
