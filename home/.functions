#!/usr/bin/env zsh

# quickly move to project directories + autocomplete
function p() {
  if [ -z "$1" ]; then
    cd ~/projects
  else
	  cd ~/projects/"$1"
  fi
}
compdef '_path_files -W ~/projects -/' p

# quickly move to work directories + autocomplete
function work() {
  local target_dir="${WORK_DIR:-$HOME/work}"
  if [ -z "$1" ]; then
    cd "$target_dir"
  else
    cd "$target_dir/$1"
  fi
}
compdef '_path_files -W "${WORK_DIR:-$HOME/work}" -/' work

### --------- Existing Functions (from Mathias Bynens) ------------
# Some are modified...

# Create a new directory and enter it
function mkd() {
	mkdir -p "$@" && cd "$_";
}

# Normalize `open` across Linux, macOS, and Windows.
# This is needed to make `server` and `o` functions cross-platform.
if [ ! "$(uname -s)" = 'Darwin' ]; then
	if grep -q Microsoft /proc/version 2>/dev/null; then
		# Ubuntu on Windows using the Linux subsystem
		alias open='explorer.exe';
	else
		alias open='xdg-open';
	fi
fi

# Change working directory to the top-most Finder window location (macOS only)
if [ "$(uname -s)" = 'Darwin' ]; then
	function cdf() { # short for `cdfinder`
		cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')";
	}
fi

# Determine size of a file or total size of a directory
function fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* ./*;
	fi;
}

# Use Git’s colored diff when available
hash git &>/dev/null;
if [ $? -eq 0 ]; then
	function diff() {
		git diff --no-index --color-words "$@";
	}
fi;

# Create a data URL from a file
function dataurl() {
	local mimeType=$(file -b --mime-type "$1");
	if [[ $mimeType == text/* ]]; then
		mimeType="${mimeType};charset=utf-8";
	fi
	echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')";
}

# Start an HTTP server from a directory, optionally specifying the port
function server() {
	local port="${1:-8000}";
	sleep 2 && open "http://localhost:${port}/" &
	# Set the default Content-Type to `text/plain` instead of `application/octet-stream`
	# And serve everything as UTF-8 (although not technically correct, this doesn’t break anything for binary files)
	python3 -c $'import http.server, sys\nhandler = http.server.SimpleHTTPRequestHandler\nmap = handler.extensions_map\nmap[""] = "text/plain"\nfor k in list(map.keys()):\n\tmap[k] = map[k] + ";charset=UTF-8"\nhttp.server.test(HandlerClass=handler, port=int(sys.argv[1]))' "$port";
}

# Compare original and gzipped file size
function gz() {
	local origsize=$(wc -c < "$1");
	local gzipsize=$(gzip -c "$1" | wc -c);
	local ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l);
	printf "orig: %d bytes\n" "$origsize";
	printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio";
}

# Run `dig` and display the most useful info
function digga() {
	dig +nocmd "$1" any +multiline +noall +answer;
}

# Show all the names (CNs and SANs) listed in the SSL certificate
# for a given domain
function getcertnames() {
	if [ -z "${1}" ]; then
		echo "ERROR: No domain specified.";
		return 1;
	fi;

	local domain="${1}";
	echo "Testing ${domain}…";
	echo ""; # newline

	local tmp=$(echo -e "GET / HTTP/1.0\nEOT" \
		| openssl s_client -connect "${domain}:443" -servername "${domain}" 2>&1);

	if [[ "${tmp}" = *"-----BEGIN CERTIFICATE-----"* ]]; then
		local certText=$(echo "${tmp}" \
			| openssl x509 -text -certopt "no_aux, no_header, no_issuer, no_pubkey, \
			no_serial, no_sigdump, no_signame, no_validity, no_version");
		echo "Common Name:";
		echo ""; # newline
		echo "${certText}" | grep "Subject:" | sed -e "s/^.*CN=//" | sed -e "s/\/emailAddress=.*//";
		echo ""; # newline
		echo "Subject Alternative Name(s):";
		echo ""; # newline
		echo "${certText}" | grep -A 1 "Subject Alternative Name:" \
			| sed -e "2s/DNS://g" -e "s/ //g" | tr "," "\n" | tail -n +2;
		return 0;
	else
		echo "ERROR: Certificate not found.";
		return 1;
	fi;
}

# `o` with no arguments opens the current directory, otherwise opens the given
# location
function o() {
	if [ $# -eq 0 ]; then
		open .;
	else
		open "$@";
	fi;
}

# `treee` is a longer for `tree` with hidden files and color enabled, ignoring
# the `.git` directory, listing directories first. The output gets piped into
# `less` with options to preserve color and line numbers, unless the output is
# small enough for one screen.
function treee() {
	tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX;
}

### --------- Secrets Management (SOPS + age) --------------------

# Internal helper: resolve a secret target (services/<name>, projects/<name>, or bare <name>)
# to its relative path inside $SECRETS_DIR (e.g. services/example.enc.env).
function _secrets_resolve_rel() {
	local target="$1"
	local mode="${2:-existing}" # "existing" or "edit"
	local secrets_dir="${SECRETS_DIR:-$HOME/projects/secrets}"

	# Strip optional .enc.env suffix if passed
	target="${target%.enc.env}"

	if [[ "$target" == */* ]]; then
		echo "${target}.enc.env"
		return 0
	fi

	local svc_rel="services/${target}.enc.env"
	local proj_rel="projects/${target}.enc.env"
	local root_rel="${target}.enc.env"

	if [[ -f "${secrets_dir}/${svc_rel}" && -f "${secrets_dir}/${proj_rel}" ]]; then
		echo "Error: ambiguous secret '$target' exists in both services/ and projects/. Specify 'services/$target' or 'projects/$target'." >&2
		return 1
	elif [[ -f "${secrets_dir}/${svc_rel}" ]]; then
		echo "$svc_rel"
	elif [[ -f "${secrets_dir}/${proj_rel}" ]]; then
		echo "$proj_rel"
	elif [[ -f "${secrets_dir}/${root_rel}" ]]; then
		echo "$root_rel"
	elif [[ "$mode" == "edit" ]]; then
		# Default new bare targets to services/<name>.enc.env
		echo "$svc_rel"
	else
		echo "Error: secret '$target' not found in $secrets_dir (checked services/, projects/, and root)." >&2
		return 1
	fi
}

# Create or edit an encrypted secret file ($SECRETS_DIR/{services,projects}/<name>.enc.env)
# Usage: secrets-edit [services/<name>|projects/<name>|<name>]
function secrets-edit() {
	local target="$1"
	if [[ -z "$target" ]]; then
		echo "Usage: secrets-edit <services/name | projects/name | name>" >&2
		return 1
	fi

	local secrets_dir="${SECRETS_DIR:-$HOME/projects/secrets}"
	local sops_config="${secrets_dir}/.sops.yaml"

	if [[ ! -d "$secrets_dir" ]]; then
		echo "Error: SECRETS_DIR does not exist: $secrets_dir" >&2
		return 1
	fi

	local rel_path
	rel_path="$(_secrets_resolve_rel "$target" edit)" || return 1
	mkdir -p "${secrets_dir}/$(dirname "$rel_path")"

	# Ensure GUI editors like VS Code wait for the temp file to be closed before sops re-encrypts
	local sops_editor="${EDITOR:-nano}"
	if [[ "$sops_editor" == "code" ]]; then
		sops_editor="code --wait"
	fi

	local -a sops_args=()
	if [[ -f "$sops_config" ]]; then
		sops_args+=(--config "$sops_config")
	fi

	# Run from SECRETS_DIR so .sops.yaml path_regex rules match reliably
	(
		cd "$secrets_dir" &&
		SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}" \
		EDITOR="$sops_editor" \
		sops "${sops_args[@]}" "$rel_path"
	)
}

# List available encrypted secret files in $SECRETS_DIR (services/ and projects/)
function secrets-list() {
	local secrets_dir="${SECRETS_DIR:-$HOME/projects/secrets}"
	if [[ ! -d "$secrets_dir" ]]; then
		echo "Error: SECRETS_DIR does not exist: $secrets_dir" >&2
		return 1
	fi

	local found=0
	local file rel
	for file in "$secrets_dir"/services/*.enc.env(N) "$secrets_dir"/projects/*.enc.env(N) "$secrets_dir"/*.enc.env(N); do
		rel="${file#$secrets_dir/}"
		echo "${rel%.enc.env}"
		found=1
	done

	if [[ $found -eq 0 ]]; then
		echo "No encrypted secret files (*.enc.env) found in $secrets_dir" >&2
	fi
}

# Run a one-off command with a secret file's variables injected in memory via sops exec-env
# Usage: secrets-run <services/name | projects/name | name> -- <cmd...>
function secrets-run() {
	local target="$1"
	shift || true
	if [[ "$1" == "--" ]]; then
		shift
	fi

	if [[ -z "$target" || $# -eq 0 ]]; then
		echo "Usage: secrets-run <services/name | projects/name | name> -- <cmd...>" >&2
		return 1
	fi

	local secrets_dir="${SECRETS_DIR:-$HOME/projects/secrets}"
	local rel_path
	rel_path="$(_secrets_resolve_rel "$target" existing)" || return 1
	local secret_file="${secrets_dir}/${rel_path}"

	if [[ ! -f "$secret_file" ]]; then
		echo "Error: secret file not found: $secret_file" >&2
		return 1
	fi

	# Quote command arguments safely for sops exec-env (which invokes a shell)
	local cmd_str=""
	local arg
	for arg in "$@"; do
		cmd_str+="${(q)arg} "
	done

	SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}" \
		sops exec-env "$secret_file" "$cmd_str"
}

# Tab completion for secrets-edit and secrets-run
function _secrets_services() {
	local secrets_dir="${SECRETS_DIR:-$HOME/projects/secrets}"
	local -a targets=()
	local f rel
	for f in "$secrets_dir"/services/*.enc.env(N) "$secrets_dir"/projects/*.enc.env(N) "$secrets_dir"/*.enc.env(N); do
		rel="${f#$secrets_dir/}"
		targets+=("${rel%.enc.env}")
	done
	compadd -a targets
}
compdef _secrets_services secrets-edit secrets-run
