#!/usr/bin/env zsh

# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Add ~/.local/bin to PATH
# It contains user-installed executables (third party)
export PATH="$HOME/.local/bin:$PATH"

# Add `~/bin` to the `$PATH`
# This contains user created binaries and functions that are not
# managed by Homebrew, and should take precedence over system binaries.
export PATH="$HOME/bin:$PATH";

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/dijksmel/programs/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/dijksmel/programs/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/dijksmel/programs/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/dijksmel/programs/google-cloud-sdk/completion.zsh.inc'; fi

# pnpm
export PNPM_HOME="/Users/dijksmel/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end
